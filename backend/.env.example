# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/cloudy_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudy_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRE=30d

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for verification, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@cloudyapp.com

# Redis (for caching, sessions, and scraping queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google Cloud Vision API (for OCR label scanning)
# Option 1: Path to service account JSON file (recommended)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: API Key (simpler, less secure)
# GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_api_key

# Option 3: Inline credentials
# GOOGLE_CLOUD_PROJECT_ID=your_project_id
# GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Geocoding API (for address to coordinates conversion)
# Option 1: Mapbox (recommended for wine venues)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Option 2: Google Maps Geocoding API
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Web Scraping Configuration
ENABLE_SCRAPING_QUEUE=true
SCRAPING_RATE_LIMIT=1000
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30000
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# WebSocket
WS_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
MOBILE_APP_SCHEME=cloudy://

# Logging
LOG_LEVEL=debug
